---
const quotes = [
  {
    text: "I moved my whole studio in after the BeltLine lease ended. Best light in the building, and nobody blinks when I bring fabric samples through the lobby.",
    name: "Dana Okafor",
    role: "Textile Designer, Loom & Line",
  },
  {
    text: "We closed our seed round in a Departures room upstairs. Felt more honest than a downtown high-rise conference floor — investors remember it.",
    name: "Marcus Whitfield",
    role: "Founder, Ridgepole",
  },
  {
    text: "The Gates booths are the only reason I get any client calls done. Six feet of soundproofing between me and the Concourse noise.",
    name: "Priya Anand",
    role: "Freelance Producer",
  },
  {
    text: "Our five-person team has a Studio with our own door. Still close enough to the Platform to steal coffee and gossip.",
    name: "Elena Voss",
    role: "Creative Director, Voss & Farrow",
  },
  {
    text: "I've worked out of four coworking spaces in this city. This is the first one that feels like it belongs to Atlanta and not a franchise deck.",
    name: "Tobias Reyes",
    role: "Independent Architect",
  },
];
---

<section class="testimonials">
  <p class="eyebrow testimonials-eyebrow" data-reveal>From the Concourse</p>

  <div class="marquee" data-marquee>
    <div class="marquee-track">
      {quotes.map((q) => (
        <figure class="quote-card">
          <span class="quote-mark" aria-hidden="true">&ldquo;</span>
          <blockquote>{q.text}</blockquote>
          <figcaption>
            <span class="quote-avatar">{q.name.charAt(0)}</span>
            <span>
              <span class="quote-name">{q.name}</span>
              <span class="quote-role">{q.role}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--color-ink);
    padding-block: clamp(4rem, 10vw, 6rem);
    overflow: hidden;
  }

  .testimonials-eyebrow {
    color: var(--color-brass);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .quote-card {
    width: min(80vw, 24rem);
    flex-shrink: 0;
    margin: 0 0.75rem;
    padding: 1.75rem;
    background: var(--color-ink-soft);
    border: 1px solid color-mix(in srgb, var(--color-bone) 10%, transparent);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
  }

  .quote-mark {
    font-family: var(--font-display);
    font-size: 2.75rem;
    color: var(--color-clay-bright);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .quote-card blockquote {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-bone) 92%, transparent);
  }

  .quote-card figcaption {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quote-avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-moss);
    color: var(--color-bone);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    flex-shrink: 0;
  }

  .quote-name {
    display: block;
    font-size: 0.9rem;
    color: var(--color-bone);
  }
  .quote-role {
    display: block;
    font-size: 0.78rem;
    color: var(--color-steel);
  }
</style>
